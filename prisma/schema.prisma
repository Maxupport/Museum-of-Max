generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 網站全域設定 (Site Settings)
model SiteSetting {
  key   String @id
  value String
}

// 通行密碼與權限 (Passcodes & Permissions)
model Passcode {
  id          String   @id @default(cuid())
  code        String   @unique
  note        String?  // 備註 (e.g. "給 VC 的訪客")
  avatarUrl   String?  // 專屬個人形象照圖片 URL
  permissions String   @default("[]") // JSON string Array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pageviews   PageView[]
  visitorLogs VisitorLog[]
}

// 流量統計 (Pageviews)
model PageView {
  id         String   @id @default(cuid())
  notionId   String   // 對應的 Notion Article ID
  exhibitId  String   // 所屬展區 ID
  passcodeId String?  // 是用哪組密碼登入看的 (可為空)
  passcode   Passcode? @relation(fields: [passcodeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

// 職涯經歷 (Career Items)
model CareerItem {
  id          String   @id @default(cuid())
  company     String   // 公司/機構名稱
  role        String   // 職務/職稱
  period      String   // 任職時間 (例如 "2022 - 2025")
  description String   // 說明細節
  logoUrl     String?  // 公司 Logo 圖片 URL
  photoUrl    String?  // 工作/現場照片 URL
  order       Int      @default(0) // 排序 (數字越小越前面)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 風險投資項目 (Venture Capital Items)
model VentureItem {
  id          String   @id @default(cuid())
  category    String   // 子區塊: "早期投資項目" | "創投項目評估" | "天使引路計畫"
  title       String   // 公司名稱 / 專案名稱
  logoUrl     String?  // 公司 Logo 圖片 URL
  period      String   // 執行時間 (例如 "2023 - Present")
  status      String   // 現況更新
  description String?  // 補充說明
  linkUrl     String?  // 外部相關連結 URL
  order       Int      @default(0) // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 小說連載訂閱者名單 (Novel Email Subscribers)
model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?   // 訂閱者姓名 (選填)
  novelId          String    @default("all") // 訂閱的小說 ID，預設 "all"
  sourceChapter    Int?      // 訂閱時所在的章節序號
  unsubscribeToken String?   @unique @default(cuid()) // 退訂驗證金鑰
  active           Boolean   @default(true)
  lastNotifiedAt   DateTime? // 上次發送電子報的時間
  createdAt        DateTime  @default(now())
}

// 小說更新通知日誌 (Novel Update Digest Log)
model NovelUpdate {
  id           String    @id @default(cuid())
  novelTitle   String    // 小說名稱
  chapterTitle String    // 新更新章節標題
  summary      String?   // 內容摘要
  sent         Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

// 音樂與聲音作品 (Music & Sound Items for YouTube Embeds)
model MusicItem {
  id          String   @id @default(cuid())
  category    String   @default("音樂") // "音樂" | "聲音探尋"
  title       String   // 曲目 / 創作標題
  youtubeUrl  String   // YouTube 網址
  description String?  // 曲目簡介 / 靈感說明
  order       Int      @default(0) // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 小說作品最上層資訊 (Novel Metadata)
model Novel {
  id          String   @id @default(cuid())
  title       String   @unique // 小說名稱 (例如 "越界之前")
  author      String   @default("Maxupport") // 創作者
  coverUrl    String?  // 顯示圖片 / 封面 URL
  description String?  // 小說簡介
  status      String   @default("連載中") // "連載中" | "已完結"
  order       Int      @default(0) // 排序 (數字越小越前面)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 全站文章與專題創作 (Universal Article / Writings Items)
model WritingsItem {
  id          String   @id @default(cuid())
  exhibitId   String   @default("creation_lab") // 所屬展區: "finance_insurance" | "sound" | "creation_lab" | "communication"
  category    String   @default("社群隨筆")      // 子類別標籤 (如 "社群隨筆", "小說", "投資", "保險" 等)
  title       String   // 文章/創作標題
  topic       String?  // 文章主題 (如: 隨筆/創投/職涯...)
  fbUrl       String?  // FB 原始貼文連結
  fbDate      String?  // FB 發布/上線時間 (如: 2024-05-20)
  excerpt     String?  // 摘要引言
  content     String   // 完整內容 (支援多行文字排版)
  youtubeUrl  String?  // 選填 YouTube 影片嵌入網址
  isPinned    Boolean  @default(false) // 是否置頂 (該分類頂端)
  isHidden    Boolean  @default(false) // 是否隱藏 (前台不顯示)
  views       Int      @default(0)     // 追蹤文章點擊率 / 瀏覽次數
  order       Int      @default(0)     // 排序 (數字越小越前面)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AI 爬蟲造訪紀錄 (AI Crawler Logs for OpenAI, Anthropic, Google, Perplexity, etc.)
model AiCrawlerLog {
  id         String   @id @default(cuid())
  botFamily  String   // "OpenAI" | "Anthropic" | "Google" | "Perplexity" | "Meta" | "Apple" | "Other"
  botName    String   // "GPTBot" | "ClaudeBot" | "Google-Extended" | "PerplexityBot" etc.
  userAgent  String   // Full User-Agent string
  path       String   // Visited path e.g. "/", "/museum/sound", "/projects"
  ip         String?  // Optional IP
  referer    String?  // Referer if any
  createdAt  DateTime @default(now())

  @@index([botFamily])
  @@index([createdAt])
  @@index([path])
}

// 真人訪客紀錄 (Human Visitor Logs)
model VisitorLog {
  id         String    @id @default(cuid())
  visitorId  String    // Anonymous client UUID for UV calculation
  path       String    // Visited path
  title      String?   // Page title
  referer    String?   // Document referrer
  device     String?   // "Desktop" | "Mobile" | "Tablet"
  browser    String?   // "Chrome" | "Safari" | "Firefox" | "Edge" | "Other"
  os         String?   // "macOS" | "Windows" | "iOS" | "Android" | "Linux"
  passcodeId String?   // Linked passcode ID if entered
  passcode   Passcode? @relation(fields: [passcodeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([visitorId])
  @@index([path])
  @@index([createdAt])
}
