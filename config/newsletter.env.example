# Copy ONLY required values to the deployment's encrypted environment settings.
# Never commit actual secrets. All delivery/sync/publication switches default OFF.
GOOGLE_NEWSLETTER_WEBHOOK_URL=
GOOGLE_NEWSLETTER_SECRET=
NEWSLETTER_ENABLED=false
NEWSLETTER_SHEETS_SYNC_ENABLED=false
NEWSLETTER_TEST_ONLY=true
NEWSLETTER_AUTO_UPDATES=false
# Independent novel schedule opt-in. Keep false until hidden imports, hashes and slots are verified.
NOVEL_PUBLICATION_ENABLED=false
# Existing ForMaxMuseum connection uses sec_STORE_ID + Vercel OIDC automatically.
# Optional local/server override: dedicated PRIVATE store token, never public upload token.
NOVEL_PRIVATE_BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=https://museum-of-max.vercel.app
